{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "kkg-wanayasa",
    "compatibility_date": "2024-09-23",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "pages_build_output_dir": "./dist",
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "kkg-wanayasa-db",
            "database_id": "b873f582-533c-4907-95f3-4b01f2ca0f23"
        }
    ],
    "r2_buckets": [
        {
            "binding": "STORAGE",
            "bucket_name": "kkg-wanayasa-storage"
        }
    ],
    "ai": {
        "binding": "AI"
    },
    // Jangan masukkan secrets/API keys di sini.
    // Gunakan 'npx wrangler pages secret put <NAME> --project-name kkg-wanayasa' atau '.dev.vars'.
    "vars": {
        "ENVIRONMENT": "production"
    }
}
