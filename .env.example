# =============================================================================
# KKG Gugus 3 Wanayasa — Environment Variables
# Salin file ini menjadi .dev.vars untuk pengembangan lokal:
#   copy .env.example .dev.vars   (Windows)
#   cp .env.example .dev.vars     (macOS/Linux)
# Isi nilai secret yang sebenarnya — JANGAN commit .dev.vars ke git.
# Untuk Pages: npx wrangler pages secret put ENCRYPTION_KEY --project-name kkg-wanayasa
# Sebelum mengganti key yang sudah digunakan, ikuti docs/OPERATIONS_RUNBOOK.md.
# =============================================================================

# ── Wajib untuk operasi enkripsi kredensial provider (fail-closed) ──────────
# Kunci enkripsi AES-GCM untuk API key yang disimpan di D1 (ai_providers.api_key)
# Minimal 16 karakter, ideal 32+. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Opsional tapi direkomendasikan ───────────────────────────────────────────
# Lingkungan: development | staging | production (default aplikasi: production)
ENVIRONMENT=development
# Metadata layanan eksternal; profil publik disimpan melalui setup/panel admin.
APP_NAME=RuangKKG
# APP_URL=https://gugus-anda.pages.dev
# REGION_PROFILE=purwakarta

# ── External services (isi sesuai kebutuhan) ─────────────────────────────────
# Penyimpanan berkas menggunakan binding R2 STORAGE di wrangler.jsonc.
# Opsional untuk berkas publik; tanpa ini aplikasi memakai /api/files.
# R2_PUBLIC_URL=https://files.example.org

# AI Providers — bisa juga dikelola via tabel D1 `ai_providers` (diprioritaskan DB)
MISTRAL_API_KEY=
Z_AI_API_KEY=
GEMINI_API_KEY=
VERTEX_API_KEY=
BEDROCK_API_KEY=
BEDROCK_REGION=ap-southeast-1
AI_BACKEND_KEY=

# Unsplash (untuk visual stimulus kisi/presentation)
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
# CORS_ORIGINS dipisahkan koma, contoh: https://kkg-wanayasa.app,https://preview.kkg-wanayasa.app
CORS_ORIGINS=

# ── Keamanan tambahan ────────────────────────────────────────────────────────
SECRET_KEY=
QR_SIGNING_SECRET=
