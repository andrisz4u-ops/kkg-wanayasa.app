{
  "name": "kkg-gugus3-wanayasa",
  "type": "module",
  "scripts": {
    "installation": "node ./scripts/installation.mjs",
    "dev": "node ./scripts/dev.mjs",
    "build": "npm run build:slides && vite build && npm run build:css:dist",
    "build:slides": "node ./scripts/build-slide-vendor.mjs",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/static/style.css --minify",
    "build:css:dist": "tailwindcss -i ./src/styles/input.css -o ./dist/static/style.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./public/static/style.css --watch",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name kkg-wanayasa",
    "dev:sandbox": "wrangler pages dev dist --d1=kkg-production --local --ip 0.0.0.0 --port 8788",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply kkg-wanayasa-db --local",
    "db:seed": "wrangler d1 execute kkg-wanayasa-db --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:secrets": "node ./scripts/check-secrets.mjs",
    "check:secrets:full": "node ./scripts/check-secrets.mjs --full-scan",
    "typecheck": "tsc --noEmit",
    "check:build-budget": "node ./scripts/check-build-budget.mjs",
    "check:migrations": "node ./scripts/check-migrations.mjs",
    "inspect:assessment": "node ./scripts/inspect-assessment.mjs",
    "test:integration": "node ./scripts/test-integration.mjs",
    "test:assessment-images:browser": "node ./scripts/check-assessment-image-browser.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.986.0",
    "@google/generative-ai": "^0.24.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@mistralai/mistralai": "^1.14.0",
    "@sentry/cloudflare": "^10.39.0",
    "cheerio": "^1.2.0",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "hono": "^4.13.13",
    "mammoth": "^1.11.0",
    "pptxgenjs": "4.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@mistralai/mistralai": {
      "ws": "^8.22.0"
    },
    "pptxgenjs": {
      "image-size": "^2.0.4"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260207.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.5.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.0.18",
    "wrangler": "^4.4.0"
  }
}
